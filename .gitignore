# Xcode build products
DerivedData/

# Xcode user-specific state
*.xcuserstate
xcuserdata/

# Runtime ATOM Monitor database
server/data/*.sqlite3
server/data/*.sqlite3-journal
server/data/*.sqlite3-wal
server/data/*.sqlite3-shm

# Generated ATOM Monitor artefacts
# Ignore everything in artifacts except finished MP4s and logs.
artifacts/*
!artifacts/*.mp4
!artifacts/*.log

# Raw Simulator recordings can exceed GitHub's 100 MB limit.
artifacts/*-raw.mp4

# Python generated files
__pycache__/
*.pyc

# Accidental/generated duplicate Xcode projects
* 2.xcodeproj/

# Never track raw Simulator recordings, including numbered Finder copies
artifacts/*-raw*.mp4

# macOS Finder metadata
.DS_Store
**/.DS_Store
