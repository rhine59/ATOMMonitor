# ATOM Monitor server local configuration template.
# Copy to server/.env and set real values locally. Never commit server/.env.

ATOM_INGEST_TOKEN=replace-with-local-secret

# Phase 3 PostgreSQL. The database is private to the Compose network.
POSTGRES_DB=atommonitor
POSTGRES_USER=atommonitor
POSTGRES_PASSWORD=replace-with-local-secret

# Leave blank while the API is still using SQLite during the first Phase 3
# infrastructure checkpoint. A later Git checkpoint will switch the API.
ATOM_DATABASE_URL=

# Feedback relay remains optional/deferred.
FEEDBACK_TO_NAME=Richard Hine
FEEDBACK_TO_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
