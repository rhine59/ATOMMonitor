FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir flask==3.1.2 gunicorn==23.0.0
COPY admin_control.py /app/admin_control.py
EXPOSE 8091
CMD ["gunicorn","--bind","0.0.0.0:8091","--workers","1","--threads","4","--timeout","90","--access-logfile","-","--error-logfile","-","admin_control:app"]
